# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---- Model inference (agent side) ----
# OpenRouter is provided by the course. Use ONE provider, matching the agent framework.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Only if the Claude Agent SDK path is used instead of OpenRouter:
# ANTHROPIC_API_KEY=

# ---- Existing MCP server (Part A) ----
# Fill in only the block for the server actually selected.

# Option 1 - Obsidian Local REST API MCP
# OBSIDIAN_API_KEY=
# OBSIDIAN_HOST=127.0.0.1
# OBSIDIAN_PORT=27124
# OBSIDIAN_VAULT_PATH=

# Option 2 - Microsoft Playwright MCP
# PLAYWRIGHT_MCP_HEADLESS=true
# PLAYWRIGHT_MCP_ALLOWED_ORIGINS=

# Option 3 - OpenWeather MCP
# OWM_API_KEY=

# ---- Custom MCP server (Part B) ----
# Offline/replay mode: when true the server serves recorded fixtures through the
# normal parsing path instead of calling the network. Required for the defence.
CUSTOM_MCP_OFFLINE=true
CUSTOM_MCP_FIXTURE_DIR=fixtures
CUSTOM_MCP_DATA_DIR=data
# Politeness / rate limiting for the upstream public API
CUSTOM_MCP_RATE_LIMIT_RPS=1
CUSTOM_MCP_TIMEOUT_SECONDS=15

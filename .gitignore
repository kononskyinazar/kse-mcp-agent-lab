# --- secrets / local config ---
.env
.env.local
*.local.json
config/*.local.json
config/mcp.local.json
secrets/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- node ---
node_modules/
npm-debug.log*
.playwright-mcp/

# --- data / runtime artifacts ---
data/raw/
data/cache/
*.sqlite
*.sqlite3
*.db
logs/
runs/
.tmp/

# --- stray host artifacts (macOS aliases, installers, disk images) ---
# Root-anchored: an installer dropped in the project directory, not anything
# inside demo-vault/, whose notes are part of the submission.
*.dmg
*.pkg
*.app
/Obsidian*

# Obsidian's per-vault config. The Local REST API plugin keeps its API key and a
# self-signed certificate in plugins/obsidian-local-rest-api/data.json, so this
# directory must never be committed. Graders install the plugin themselves; the
# README says how. Last rule wins in gitignore, so this stays at the end.
demo-vault/.obsidian/

# The demonstration vault ships at its seed state: one prior findings note, no
# run log. Everything the agent writes is a run artefact - committing it would
# mean a grader's first run has nothing left to demonstrate, because those
# tenders would already be in the memory.
demo-vault/procurement/findings/*
!demo-vault/procurement/findings/findings_01999218_2026-08-18.md

# Personal defence notes: the spoken script stays on this machine. The committed
# defence-checklist.md is what satisfies submission item 7 ("checklist or script").
docs/defence-script.md

# --- os / editor ---
.DS_Store
.idea/
.vscode/
